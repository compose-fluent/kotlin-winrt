<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="io.github.composefluent.kotlinwinrt.controls"
    Publisher="CN=KotlinWinRT Development"
    Version="1.0.0.5"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Kotlin WinRT Controls</DisplayName>
    <PublisherDisplayName>Kotlin WinRT Development</PublisherDisplayName>
    <Description>Kotlin/WinRT WinUI controls sample</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="Controls"
      Executable="winrt-samples.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Kotlin WinRT Controls"
        Description="Kotlin/WinRT WinUI controls sample"
        BackgroundColor="#006C67"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
