<idea-plugin>
    <id>io.github.composefluent.winrt.ide</id>
    <name>Kotlin WinRT</name>
    <vendor>Compose Fluent</vendor>
    <description><![CDATA[Kotlin WinRT project integration and XAML tooling.]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.gradle</depends>
    <!-- ANDROID_STUDIO_EXTENSION -->
    <dependencies>
        <module name="intellij.platform.compose"/>
        <module name="intellij.platform.jewel.ideLafBridge"/>
        <module name="intellij.platform.jewel.markdown.core"/>
        <module name="intellij.platform.jewel.markdown.ideLafBridgeStyling"/>
    </dependencies>
    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="io.github.composefluent.winrt.ide.run.WinRTApplicationConfigurationType"/>
        <programRunner implementation="io.github.composefluent.winrt.ide.debug.WinRTNativeDebugRunner" order="first"/>
        <xdebugger.breakpointType implementation="io.github.composefluent.winrt.ide.debug.WinRTNativeLineBreakpointType"/>
        <applicationConfigurable id="KotlinWinRT.Settings" parentId="tools" displayName="Kotlin WinRT"
                                 instance="io.github.composefluent.winrt.ide.settings.WinRTIdeConfigurable"/>
        <postStartupActivity implementation="io.github.composefluent.winrt.ide.project.WinRTProjectActivity"/>
        <fileType name="WinRT AppX XML" language="XML" extensions="resw;appxmanifest"
                  implementationClass="io.github.composefluent.winrt.ide.resources.AppxManifestXmlFileType" fieldName="INSTANCE"/>
        <fileEditorProvider implementation="io.github.composefluent.winrt.ide.resources.WinRTXmlFormEditorProvider"/>
        <fileEditorProvider implementation="io.github.composefluent.winrt.ide.preview.WinUIXamlPreviewEditorProvider"/>
        <xml.schemaProvider implementation="io.github.composefluent.winrt.ide.resources.AppxManifestSchemaProvider"/>
        <newProjectWizard.generator implementation="io.github.composefluent.winrt.ide.templates.WinRTProjectWizard"/>
        <fileType name="WinRT XAML" language="XML" extensions="xaml"
                  implementationClass="io.github.composefluent.winrt.ide.xaml.WinUIXamlFileType" fieldName="INSTANCE"/>
        <xml.elementDescriptorProvider implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlDescriptorProvider"/>
        <xml.implicitNamespaceDescriptorProvider implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlNamespaceProvider"/>
        <xml.schemaProvider implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlSchemaProvider"/>
        <completion.contributor language="XML" order="first" implementationClass="io.github.composefluent.winrt.ide.xaml.WinUIXamlCompletionContributor"/>
        <psi.referenceContributor language="XML" implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlReferenceContributor"/>
        <annotator language="XML" implementationClass="io.github.composefluent.winrt.ide.xaml.WinUIXamlEventAnnotator"/>
        <annotator language="XML" implementationClass="io.github.composefluent.winrt.ide.xaml.WinUIXamlBindingAnnotator"/>
        <annotator language="XML" implementationClass="io.github.composefluent.winrt.ide.xaml.WinUIXamlMarkupAnnotator"/>
        <annotator language="XML" implementationClass="io.github.composefluent.winrt.ide.xaml.WinUIXamlAttributeAnnotator"/>
        <colorSettingsPage implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlColorSettingsPage"/>
        <psi.referenceContributor language="XML" implementation="io.github.composefluent.winrt.ide.resources.WinRTResourceReferenceContributor"/>
        <annotator language="XML" implementationClass="io.github.composefluent.winrt.ide.resources.WinRTResourceReferenceAnnotator"/>
        <completion.contributor language="XML" order="first" implementationClass="io.github.composefluent.winrt.ide.resources.WinRTResourceCompletion"/>
        <codeInsight.lineMarkerProvider language="kotlin" implementationClass="io.github.composefluent.winrt.ide.xaml.WinUIXamlRelatedMarker"/>
        <gotoDeclarationHandler implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlGeneratedNavigation"/>
        <gotoDeclarationHandler implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlAttributeNavigation"/>
        <referencesSearch implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlNameReferencesSearch"/>
        <referencesSearch implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlKotlinReferencesSearch"/>
        <implicitUsageProvider implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlImplicitUsageProvider"/>
        <renamePsiElementProcessor implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlNameRenameProcessor"/>
        <renamePsiElementProcessor implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlClassRenameProcessor" order="last"/>
        <renamePsiElementProcessor implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlKotlinRenameProcessor" order="last"/>
        <renameHandler implementation="io.github.composefluent.winrt.ide.xaml.WinUIXamlNameRenameHandler" order="first"/>
        <toolWindow id="Kotlin WinRT" anchor="right"
                    factoryClass="io.github.composefluent.winrt.ide.ui.WinRTToolWindowFactory"/>
        <externalProjectDataService implementation="io.github.composefluent.winrt.ide.gradle.WinRTProjectDataService"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
        <projectResolve implementation="io.github.composefluent.winrt.ide.gradle.WinRTProjectResolver"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="false" supportsK2="true"/>
        <bundledFirCompilerPluginProvider implementation="io.github.composefluent.winrt.ide.analysis.WinRTBundledFirProvider"/>
        <firCompilerPluginConfigurationProvider implementation="io.github.composefluent.winrt.ide.analysis.WinRTFirConfigurationProvider"/>
    </extensions>
    <projectListeners>
        <listener class="io.github.composefluent.winrt.ide.run.WinRTApplicationExecutionListener"
                  topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>
    <actions>
        <action id="KotlinWinRT.AttachNativeDebugger" class="io.github.composefluent.winrt.ide.debug.WinRTAttachNativeDebuggerAction"
                text="Attach Kotlin WinRT Native Debugger" description="Debug the running Native application with LLDB">
            <add-to-group group-id="RunMenu" anchor="last"/>
        </action>
        <action id="KotlinWinRT.NewXamlPage" class="io.github.composefluent.winrt.ide.templates.WinUINewXamlPageAction"
                text="XAML Page" description="Create a Kotlin WinRT Page with matching Kotlin and XAML files" icon="AllIcons.FileTypes.Xml">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
        <action id="KotlinWinRT.NewXamlUserControl" class="io.github.composefluent.winrt.ide.templates.WinUINewXamlUserControlAction"
                text="XAML UserControl" description="Create a Kotlin WinRT UserControl with matching Kotlin and XAML files" icon="AllIcons.FileTypes.Xml">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
        <action id="KotlinWinRT.NewXamlResources" class="io.github.composefluent.winrt.ide.templates.WinUINewXamlResourcesAction"
                text="XAML ResourceDictionary" description="Create a XAML resource dictionary" icon="AllIcons.FileTypes.Xml">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
