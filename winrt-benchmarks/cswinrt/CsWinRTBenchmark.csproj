<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <CsWinRTIncludes>BenchmarkComponent</CsWinRTIncludes>
    <BenchmarkComponentRoot Condition="'$(BenchmarkComponentRoot)' == ''">$(MSBuildThisFileDirectory)..\build\reference-benchmark-component</BenchmarkComponentRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the benchmark on the same public CsWinRT release pinned by the local .cswinrt baseline. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <CsWinRTInputs Include="$(BenchmarkComponentRoot)\BenchmarkComponent.winmd" />
    <None Include="$(BenchmarkComponentRoot)\BenchmarkComponent.dll" Link="BenchmarkComponent.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\.cswinrt\src\Benchmarks\QueryInterface.cs" Link="Reference\QueryInterface.cs" />
    <Compile Include="..\..\.cswinrt\src\Benchmarks\EventPerf.cs" Link="Reference\EventPerf.cs" />
    <Compile Include="..\..\.cswinrt\src\Benchmarks\GuidPerf.cs" Link="Reference\GuidPerf.cs" />
    <Compile Include="..\..\.cswinrt\src\Benchmarks\ReflectionPerf.cs" Link="Reference\ReflectionPerf.cs" />
    <Compile Include="..\..\.cswinrt\src\Benchmarks\AsyncPerf.cs" Link="Reference\AsyncPerf.cs" />
    <Compile Include="..\..\.cswinrt\src\Benchmarks\NonAgileObjectPerf.cs" Link="Reference\NonAgileObjectPerf.cs" />
  </ItemGroup>

</Project>
