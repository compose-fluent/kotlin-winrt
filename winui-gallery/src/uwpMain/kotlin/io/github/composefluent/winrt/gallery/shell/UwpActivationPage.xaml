<Page x:Class="io.github.composefluent.winrt.gallery.shell.UwpActivationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16">
        <TextBlock Text="Activate the Gallery through Windows protocol, file and background-task entry points. Results are recorded in LocalState/gallery.log." TextWrapping="Wrap" />
        <Button Content="Launch protocol" Click="Protocol_Click" />
        <Button Content="Open .kwgallery file" Click="File_Click" />
        <Button Content="Run background task" Click="Background_Click" />
        <TextBlock x:Name="Status" TextWrapping="Wrap" />
    </StackPanel>
</Page>
