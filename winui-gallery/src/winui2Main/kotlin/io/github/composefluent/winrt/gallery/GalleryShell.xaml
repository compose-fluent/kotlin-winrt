<Page x:Class="io.github.composefluent.winrt.gallery.GalleryShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <muxc:NavigationView x:Name="navigation" PaneDisplayMode="Auto" IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed" PaneTitle="Kotlin WinUI 2 Gallery" ItemInvoked="onItemInvoked">
            <muxc:NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="search" PlaceholderText="Search controls" TextChanged="onSearchChanged"
                    AutomationProperties.Name="Search controls" />
            </muxc:NavigationView.AutoSuggestBox>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Padding="32" Spacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="pageTitle" Text="Kotlin WinUI 2 Gallery" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ComboBox x:Name="themePicker" Grid.Column="1" Header="Theme" MinWidth="110" SelectedIndex="0" SelectionChanged="onThemeChanged">
                            <ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="description" TextWrapping="Wrap" />
                    <StackPanel x:Name="sampleHost" Spacing="16" />
                    <TextBlock x:Name="output" TextWrapping="Wrap" AutomationProperties.Name="Sample output" />
                    <TextBlock Text="Kotlin" FontSize="18" FontWeight="SemiBold" />
                    <Border BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="16" CornerRadius="4">
                        <TextBlock x:Name="sourceCode" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </muxc:NavigationView>
    </Grid>
</Page>
