<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:io.github.composefluent.winrt.gallery.controls"
      x:Class="io.github.composefluent.winrt.gallery.basicinput.ToggleButtonPage">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../GalleryExampleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel>
        <controls:ControlExample x:Name="toggleExample" SampleDefinition="ToggleButton\ToggleButtonSimple.txt">
            <controls:ControlExample.Example>
                <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                    <ToggleButton x:Name="toggleButton" Content="ToggleButton" Click="onToggleClick" />
                </StackPanel>
            </controls:ControlExample.Example>
            <controls:ControlExample.Output>
                <TextBlock x:Name="output" Text="Off" />
            </controls:ControlExample.Output>
            <controls:ControlExample.Options>
                <StackPanel>
                    <CheckBox x:Name="disableToggle" Content="Disable ToggleButton" Click="onDisableClick" />
                </StackPanel>
            </controls:ControlExample.Options>
        </controls:ControlExample>
    </StackPanel>
</Page>
