<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:io.github.composefluent.winrt.gallery.controls"
      x:Class="io.github.composefluent.winrt.gallery.basicinput.RepeatButtonPage">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../GalleryExampleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel>
        <controls:ControlExample x:Name="repeatExample" SampleDefinition="RepeatButton\RepeatButtonSimple.txt">
            <controls:ControlExample.Example>
                <StackPanel Orientation="Horizontal">
                    <RepeatButton x:Name="repeatButton" Content="Click and hold" Click="onRepeatClick" />
                    <TextBlock x:Name="output" Margin="8,0,0,0" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="Control output" />
                </StackPanel>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <CheckBox x:Name="disableRepeat" Content="Disable RepeatButton" Click="onDisableClick" />
            </controls:ControlExample.Options>
        </controls:ControlExample>
    </StackPanel>
</Page>
