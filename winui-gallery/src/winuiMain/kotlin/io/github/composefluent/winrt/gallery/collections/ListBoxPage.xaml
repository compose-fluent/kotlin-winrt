<Page x:Class="io.github.composefluent.winrt.gallery.collections.ListBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:io.github.composefluent.winrt.gallery.controls">
    <StackPanel>
        <controls:ControlExample SampleDefinition="ListBox/Inline.txt">
            <StackPanel>
                <ListBox x:Name="ColorsList" MinWidth="200" SelectionChanged="ColorChanged"><x:String>Blue</x:String><x:String>Green</x:String><x:String>Red</x:String><x:String>Yellow</x:String></ListBox>
                <Rectangle x:Name="colorOutput" Width="100" Height="30" Margin="0,10,0,0" />
            </StackPanel>
        </controls:ControlExample>
        <controls:ControlExample SampleDefinition="ListBox/Fonts.txt">
            <StackPanel>
                <ListBox x:Name="FontsList" Height="164" SelectedIndex="2" SelectionChanged="FontChanged"><x:String>Arial</x:String><x:String>Comic Sans MS</x:String><x:String>Courier New</x:String><x:String>Segoe UI</x:String><x:String>Times New Roman</x:String></ListBox>
                <TextBlock x:Name="fontOutput" Text="You can set the font used for this text." FontFamily="Courier New" Margin="0,10,0,0" />
            </StackPanel>
        </controls:ControlExample>
    </StackPanel>
</Page>
