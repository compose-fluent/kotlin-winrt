<?xml version="1.0" encoding="utf-8" ?>
<!-- #if WINUI3 -->
<winui:WindowEx
<!-- #else -->
<UserControl
<!-- #endif -->
    x:Class="io.github.composefluent.winrt.gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:io.github.composefluent.winrt.gallery"
    xmlns:winui="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:io.github.composefluent.winrt.gallery.pages"
<!-- #if WINUI3 -->
    Title="Kotlin WinUI Gallery"
    ContextMenu="{x:Bind WindowMenu}"
<!-- #else -->
    BackdropMaterial.ApplyToRootOrPageBackground="True"
<!-- #endif -->
    mc:Ignorable="d">
    <x:Properties>
        <x:Property Name="GalleryTitle" Type="x:String" DefaultValue="Kotlin WinUI Gallery" />
    </x:Properties>
<!-- #if WINUI3 -->
    <winui:WindowEx.SystemBackdrop>
        <winui:MicaBackdropWithFallback>
            <winui:MicaBackdropWithFallback.Fallback>
                <winui:TenMicaBackdrop BindThemeTo="{x:Bind RootGrid}" />
            </winui:MicaBackdropWithFallback.Fallback>
        </winui:MicaBackdropWithFallback>
    </winui:WindowEx.SystemBackdrop>
<!-- #endif -->
    <Grid x:Name="RootGrid">
<!-- #if WINUI3 -->
        <Grid.Resources>
            <winui:ModernStandardWindowContextMenu x:Name="WindowMenu" Window="{x:Bind Window}" />
        </Grid.Resources>
<!-- #endif -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
<!-- #if WINUI3 -->
        <winui:WindowCaptionButtonThemeWorkaround Window="{x:Bind Window}" />
        <winui:ModernWindowCaptionButtonToolTip Window="{x:Bind Window}" />
        <TitleBar
            x:Name="titleBar"
            Title="{x:Bind GalleryTitle, Mode=OneWay}"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Tiles/GalleryIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
<!-- #else -->
        <Grid x:Name="UWPTitleBarHost" MinHeight="48">
            <Grid x:Name="UWPTitleBarDragRegion" Background="Transparent">
                <StackPanel x:Name="UWPTitleBarBrand" Margin="16,0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Image Source="/Assets/AppList.png" Width="16" Height="16" />
                    <TextBlock Text="{x:Bind GalleryTitle}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <!-- Interactive content is a sibling above the SetTitleBar drag region. -->
            <StackPanel x:Name="UWPTitleBarNavigation" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" Spacing="4">
                <Button x:Name="UWPBackButton" Width="40" Height="44" Padding="0" Visibility="Collapsed"
                        Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back (Alt+Left)">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <Button x:Name="UWPPaneToggleButton" Width="40" Height="44" Padding="0"
                        Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="Toggle navigation" ToolTipService.ToolTip="Toggle navigation">
                    <FontIcon Glyph="&#xE700;" FontSize="16" />
                </Button>
            </StackPanel>
            <Grid x:Name="UWPTitleBarInteractive" Margin="240,8,16,8">
<!-- #endif -->
                <AutoSuggestBox
                    x:Name="controlsSearchBox"
<!-- #if WINUI3 -->
                    Width="320"
<!-- #endif -->
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    x:FieldModifier="public"
                    KeyboardAcceleratorPlacementMode="Hidden"
                    PlaceholderText="Search controls and samples..."
                    QueryIcon="Find">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="F"
                            Modifiers="Control" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
<!-- #if WINUI3 -->
            </TitleBar.Content>
        </TitleBar>
<!-- #else -->
            </Grid>
        </Grid>
<!-- #endif -->
        <NavigationView
            x:Name="NavigationViewControl"
            Grid.Row="1"
            Canvas.ZIndex="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
<!-- #if WINUI2 -->
            IsTitleBarAutoPaddingEnabled="False"
<!-- #endif -->
            IsTabStop="False">
            <Frame HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsNavigationStackEnabled="False"
                x:Name="rootFrame" />
        </NavigationView>
    </Grid>
<!-- #if WINUI3 -->
</winui:WindowEx>
<!-- #else -->
</UserControl>
<!-- #endif -->
