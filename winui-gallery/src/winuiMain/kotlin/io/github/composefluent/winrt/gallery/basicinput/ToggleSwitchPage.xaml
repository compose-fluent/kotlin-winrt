<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:io.github.composefluent.winrt.gallery.controls"
      x:Class="io.github.composefluent.winrt.gallery.basicinput.ToggleSwitchPage">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../GalleryExampleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel>
        <controls:ControlExample x:Name="simpleExample" SampleDefinition="ToggleSwitch\ToggleSwitchSimple.txt">
            <controls:ControlExample.Example>
                <ToggleSwitch x:Name="simpleToggle" AutomationProperties.Name="simple ToggleSwitch" />
            </controls:ControlExample.Example>
        </controls:ControlExample>
        <controls:ControlExample x:Name="workExample" SampleDefinition="ToggleSwitch\ToggleSwitchCustomContent.txt">
            <controls:ControlExample.Example>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch x:Name="workToggle" Header="Toggle work" IsOn="True"
                                  OffContent="Do work" OnContent="Working" Toggled="onWorkToggled" />
                    <ProgressRing x:Name="progress" Width="32" IsActive="True" />
                </StackPanel>
            </controls:ControlExample.Example>
        </controls:ControlExample>
    </StackPanel>
</Page>
